<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. scripts/package-msix.ps1 fills in the
     $(...) values: the identity comes from Partner Center (Product identity
     page), the version from Directory.Build.props, the architecture per build. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="$(IdentityName)"
    Publisher="$(Publisher)"
    Version="$(Version)"
    ProcessorArchitecture="$(Architecture)" />

  <Properties>
    <!-- Must match the name reserved in Partner Center; Start shows the shorter one below. -->
    <DisplayName>Yowl - Laptop Theft Alarm</DisplayName>
    <PublisherDisplayName>$(PublisherDisplayName)</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>A theft alarm for your laptop. Pull the charger, move the laptop or close the lid while it is armed and it screams at full volume through the built-in speakers, locks the screen, photographs whoever is there and can send the photos to your phone.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Yowl" Executable="Yowl.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Yowl"
        Description="A theft alarm for your laptop."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        AppListEntry="default">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start at login". Off until the user turns it on in Settings. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="YowlStartup" Enabled="false" DisplayName="Yowl" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
